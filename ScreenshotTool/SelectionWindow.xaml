<Window x:Class="ScreenshotTool.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        Cursor="Cross"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        KeyDown="Window_KeyDown">
   
    <Grid>
        <Image x:Name="BgImage" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderOptions.EdgeMode="Aliased"/>
        
        <Path x:Name="DimMask" Fill="#55000000" IsHitTestVisible="False" />
        <Canvas x:Name="MainCanvas" Background="Transparent">
            <Rectangle x:Name="SelectionRect"
                       Stroke="#00A8FF"
                       StrokeThickness="2"
                       StrokeDashArray="4 2"
                       Visibility="Collapsed" />
        </Canvas>
    </Grid>

</Window>
